{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "294a9a8ddaf4557e91b4b88002e064ac",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "M3CrystalShield (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 280,
            "y": 0,
            "width": 230,
            "height": 150
        }
    },
    "m_Slots": [
        {
            "m_Id": "691b452ece1e5ca69110d754edb13e93"
        },
        {
            "m_Id": "85016d4e8c685fb89cd8d9110ceff639"
        },
        {
            "m_Id": "3d28d4fdf988584b8427b36595d5b691"
        },
        {
            "m_Id": "bde3e8c4767c5c5ba6a5bce7ffd8a4a3"
        },
        {
            "m_Id": "782e04ab440b5e9590d8435664c6da1f"
        },
        {
            "m_Id": "21523937e1065ecc8a8258a0bc63cbf3"
        },
        {
            "m_Id": "9f4cd0f4e18c5527a6fae998d48372b0"
        },
        {
            "m_Id": "456168eca76c53ada323697e29a0f751"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "M3CrystalShield",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Smooth normals define the Fresnel rim; derivatives reveal the mesh triangle facets.\nfloat3 n = normalize(Normal);\nfloat3 view = normalize(View);\nfloat fresnel = pow(1.0 - saturate(abs(dot(n, view))), 2.2);\nfloat3 facetCross = cross(ddx(Position), ddy(Position));\nfloat3 facetNormal = facetCross * rsqrt(max(dot(facetCross, facetCross), 0.000001));\nfloat facet = saturate(abs(dot(facetNormal, normalize(float3(0.4, 0.8, 0.3)))));\nColor = lerp(Secondary.rgb, Primary.rgb, 0.25 + 0.65 * facet) + Secondary.rgb * fresnel * 0.5;\nAlpha = Primary.a * (0.12 + 0.2 * facet + 0.55 * fresnel) * (1.0 - saturate(Progress));"
}

