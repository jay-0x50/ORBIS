{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ecd900b03dc657c49983dfa96582820f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "M3SwirlRing (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 280,
            "y": 0,
            "width": 230,
            "height": 150
        }
    },
    "m_Slots": [
        {
            "m_Id": "fc5827ddf6e0562cae7da42e4ab17ccd"
        },
        {
            "m_Id": "c7a5c17de3a35e709245662d7c6380fd"
        },
        {
            "m_Id": "30aa0341a04c56a6a7531fff30e11ca7"
        },
        {
            "m_Id": "b328215aafab5de988da9eed162e6d9b"
        },
        {
            "m_Id": "ecb8f5f0c385580eb578b27c73b6a256"
        },
        {
            "m_Id": "871795c3c6945b298e16912413488bd1"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "M3SwirlRing",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Ring radius/feather are visual defaults; the runtime expands the mesh independently.\nfloat2 xy = UV.xy * 2.0 - 1.0;\nfloat radius = length(xy);\nfloat ring = smoothstep(0.57, 0.67, radius) * (1.0 - smoothstep(0.85, 0.98, radius));\nfloat swirl = 0.5 + 0.5 * sin(atan2(xy.y, xy.x) * 5.0 - Progress * 9.0 + radius * 10.0);\nColor = lerp(Primary.rgb, Secondary.rgb, swirl);\nAlpha = Primary.a * ring * (0.45 + 0.55 * swirl) * (1.0 - saturate(Progress));"
}

