        },
        {
            "m_Id": "24f75a4561cf589c8dd56f7de72f89d4"
        },
        {
            "m_Id": "aeb357435e23504896211a09fdf7eeb6"
        },
        {
            "m_Id": "3683f0c9805a53bd9cad8e7daa18ad3c"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "M3Outline",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float p = saturate(Progress);\nColor = lerp(Secondary.rgb, Primary.rgb, p);\nAlpha = Primary.a * (1.0 - p);"
}

