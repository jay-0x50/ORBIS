    },
    "m_SourceType": 1,
    "m_FunctionName": "M3OutlineShell",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Default shell width is 0.03 object-space units. Back-face rendering leaves an outer silhouette.\nOut = Position + normalize(Normal) * max(0.0, Thickness);"
}

