{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "4204ce72206e5e09a5858440ca635de7",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "M3WeaponTrail (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 280,
            "y": 0,
            "width": 230,
            "height": 150
        }
    },
    "m_Slots": [
        {
            "m_Id": "62523c5f456854658ac0182a7b283a71"
        },
        {
            "m_Id": "d27c49245c8c50e7b6300f59eb4ec775"
        },
        {
            "m_Id": "94290b22d1c85646854ce4175447d837"
        },
        {
            "m_Id": "448fbf264e2c5453b5cc6bff65596261"
        },
        {
            "m_Id": "957d8130f97357c79e6dd60f98f3a90a"
        },
        {
            "m_Id": "675ddbea97545cd18ea42cef23dcb418"
        },
        {
            "m_Id": "176c3ead02ef59d8ab8352c3427cc30b"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "M3WeaponTrail",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// TrailRenderer UV0.y spans its width; native vertex alpha carries the lifetime gradient.\nfloat across = saturate(UV.y);\nfloat edge = smoothstep(0.0, 0.16, across) * smoothstep(0.0, 0.16, 1.0 - across);\nColor = lerp(Primary.rgb, Secondary.rgb, 1.0 - abs(across * 2.0 - 1.0)) * VertexColor.rgb;\nAlpha = Primary.a * VertexColor.a * edge * (1.0 - saturate(Progress));"
}

